DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zayna"
# Optional for serverless production runtimes that support pooled Postgres connections.
DATABASE_URL_POOLED=""
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
ADMIN_EMAILS="admin@example.com"
ADMIN_USER_IDS=""
# Optional comma-separated order-operation role assignments. Other authorized admins remain ADMIN.
ORDER_AGENT_USER_IDS=""
ORDER_AGENT_EMAILS=""
ORDER_MANAGER_USER_IDS=""
ORDER_MANAGER_EMAILS=""

# Required in production: random bearer token (at least 32 bytes) for the
# scheduled loyalty-expiration endpoint. Never reuse an admin or provider key.
CRON_SECRET="replace_with_random_cron_secret"

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_replace_me"
CLERK_SECRET_KEY="sk_test_replace_me"

# Optional: WhatsApp order confirmations via Twilio.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""
TWILIO_CONTENT_SID=""
TWILIO_WHATSAPP_ORDER_TEMPLATE_SID=""
TWILIO_WHATSAPP_DEFAULT_COUNTRY_CODE="+212"

# Optional limits for the offline HeyPara import script only.
HEYPARA_CATEGORY_LIMIT=""
HEYPARA_PER_COLLECTION_CAP=""
HEYPARA_PRODUCT_LIMIT=""

# Optional: expose the CMI card flow only when these are configured.
NEXT_PUBLIC_ENABLE_CMI="false"
CMI_CLIENT_ID=""
CMI_STORE_KEY=""

# Base64-encoded 32-byte key for stable Server Action IDs across deploys/restarts.
# Example generation: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="replace_with_base64_32_byte_key"
